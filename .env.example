# Use a normal HTTP API key for your Beijing Bailian workspace.
# The existing sk-ws-... Realtime key is not assumed to work with this endpoint.
DASHSCOPE_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-flash

# Local browser UI. Keep loopback for the first test.
DUDU_HOST=127.0.0.1
DUDU_PORT=8080
DUDU_DEVICE_PORT=8000
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
# Optional proxy used only for Edge TTS, for example http://127.0.0.1:7890
EDGE_TTS_PROXY=
